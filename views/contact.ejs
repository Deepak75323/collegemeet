            <div class="cp-info-card__icon"><i class="fas fa-coffee"></i></div>
            <div class="cp-info-card__label">Timezone</div>
            <div class="cp-info-card__value">IST (UTC +5:30)</div>
          </div>
          <div class="cp-info-card cp-info-card--pink">
            <div class="cp-info-card__icon"><i class="fas fa-briefcase"></i></div>
            <div class="cp-info-card__label">Availability</div>
            <div class="cp-info-card__value">Immediate</div>
          </div>
          <div class="cp-info-card cp-info-card--cyan">
            <div class="cp-info-card__icon"><i class="fas fa-code"></i></div>
            <div class="cp-info-card__label">Experience</div>
            <div class="cp-info-card__value">Full-Stack Dev</div>
          </div>
        </div>

        <!-- Social links -->
        <div class="cp-socials cp-reveal cp-reveal--delay-3">
          <div class="cp-socials__label">Find me online</div>
          <div class="cp-socials__links">
            <a href="https://github.com/" target="_blank" rel="noopener" class="cp-social-btn">
              <i class="fab fa-github"></i> GitHub
            </a>
            <a href="https://linkedin.com/" target="_blank" rel="noopener" class="cp-social-btn">
              <i class="fab fa-linkedin-in"></i> LinkedIn
            </a>
            <a href="https://twitter.com/" target="_blank" rel="noopener" class="cp-social-btn">
              <i class="fab fa-twitter"></i> Twitter
            </a>
          </div>
        </div>

      </div><!-- /cp-left -->

      <!-- ── Right: Form ──────────────────────────────────────────────────────── -->
      <div class="cp-form-card cp-reveal cp-reveal--delay-2">

        <!-- Success state -->
        <div class="cp-success" id="cp-success">
          <div class="cp-success__icon">✓</div>
          <h3 class="cp-success__title">Message Sent!</h3>
          <p class="cp-success__body">
            Thanks for reaching out! I'll get back to you within 24 hours.<br>
            Looking forward to our conversation.
          </p>
          <a href="/" class="cp-success__btn"><i class="fas fa-arrow-left"></i> Back to Home</a>
        </div>

        <!-- Form -->
        <div class="cp-form-inner" id="cp-form-inner">
          <h2 class="cp-form-card__title">Send a Message</h2>
          <p class="cp-form-card__sub">Fill out the form and I'll get back to you as soon as possible.</p>

          <form id="cp-form" action="/thankyou" method="post" novalidate>

            <div class="cp-form-row">
              <div class="cp-field" data-type="input">
                <input type="text" name="contact_name" id="cp-name" autocomplete="name" required>
                <label for="cp-name">Your Name</label>
                <span class="cp-field__err">Please enter your name.</span>
              </div>
              <div class="cp-field" data-type="input">
                <input type="email" name="contact_email" id="cp-email" autocomplete="email" required>
                <label for="cp-email">Email Address</label>
                <span class="cp-field__err">Enter a valid email address.</span>
              </div>
            </div>

            <div class="cp-field" data-type="input">
              <input type="text" name="contact_subject" id="cp-subject" required>
              <label for="cp-subject">Subject</label>
              <span class="cp-field__err">Please enter a subject.</span>
            </div>

            <div class="cp-field cp-field--textarea" data-type="textarea">
              <textarea name="contact_message" id="cp-message" maxlength="1000" required></textarea>
              <label for="cp-message">Your Message</label>
              <span class="cp-field__count" id="cp-char-count">0 / 1000</span>
              <span class="cp-field__err">Please write your message.</span>
            </div>

            <button type="submit" class="cp-submit" id="cp-submit">
              <span class="cp-submit__text">Send Message</span>
              <span class="cp-submit__arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
              <span class="cp-submit__spinner">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
                  <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
                </svg>
              </span>
            </button>

          </form>
        </div><!-- /cp-form-inner -->

      </div><!-- /cp-form-card -->
    </div><!-- /cp-grid-2col -->
  </div><!-- /cp-content -->
</div><!-- /cp-page -->

<script>
(function () {
  /* ── Floating particles ──────────────────────────────────────────────────── */
  const bg = document.querySelector('.cp-bg');
  if (bg) {
    for (let i = 0; i < 24; i++) {
      const p = document.createElement('div');
      p.className = 'cp-particle';
      p.style.cssText = `
        left: ${Math.random() * 100}%;
        bottom: ${Math.random() * 20}%;
        width: ${Math.random() < 0.5 ? 2 : 3}px;
        height: ${Math.random() < 0.5 ? 2 : 3}px;
        animation-duration: ${8 + Math.random() * 16}s;
        animation-delay: ${-Math.random() * 16}s;
        opacity: ${0.3 + Math.random() * 0.5};
      `;
      bg.appendChild(p);
    }
  }

  /* ── Floating labels ─────────────────────────────────────────────────────── */
  document.querySelectorAll('.cp-field').forEach(function (field) {
    const input = field.querySelector('input, textarea');
    if (!input) return;

    function checkValue() {
      field.classList.toggle('has-value', input.value.trim().length > 0);
    }

    input.addEventListener('focus',  function () { field.classList.add('is-active'); });
    input.addEventListener('blur',   function () { field.classList.remove('is-active'); checkValue(); });
    input.addEventListener('input',  checkValue);
    checkValue();
  });

  /* ── Character counter ───────────────────────────────────────────────────── */
  const msgEl    = document.getElementById('cp-message');
  const countEl  = document.getElementById('cp-char-count');
  if (msgEl && countEl) {
    msgEl.addEventListener('input', function () {
      countEl.textContent = msgEl.value.length + ' / 1000';
      countEl.style.color = msgEl.value.length > 900 ? '#f87171' : '';
    });
  }

  /* ── Form validation & submission ───────────────────────────────────────── */
  const form      = document.getElementById('cp-form');
  const submitBtn = document.getElementById('cp-submit');
  const formInner = document.getElementById('cp-form-inner');
  const successEl = document.getElementById('cp-success');

  if (!form) return;

  form.addEventListener('submit', async function (e) {
    e.preventDefault();

    // Clear previous errors
    document.querySelectorAll('.cp-field').forEach(function (f) { f.classList.remove('is-error'); });

    // Validate
    let valid = true;
    const fields = [
      { id: 'cp-name',    check: function (v) { return v.trim().length >= 2; } },
      { id: 'cp-email',   check: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); } },
      { id: 'cp-subject', check: function (v) { return v.trim().length >= 2; } },
      { id: 'cp-message', check: function (v) { return v.trim().length >= 10; } },
    ];

    fields.forEach(function (f) {
      const input = document.getElementById(f.id);
      if (!input) return;
      const field = input.closest('.cp-field');
      if (!f.check(input.value)) {
        if (field) field.classList.add('is-error');
        valid = false;
      }
    });

    if (!valid) {
      // Shake the button
      submitBtn.style.animation = 'none';
      submitBtn.offsetHeight;
      submitBtn.style.animation = '';
      return;
    }

    // Loading state
    submitBtn.classList.add('cp-submit--loading');
    submitBtn.disabled = true;

    try {
      const data = new URLSearchParams(new FormData(form));
      const res  = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: data,
        redirect: 'follow',
      });

      if (res.ok) {
        // Show inline success
        formInner.classList.add('is-hidden');
        successEl.classList.add('is-visible');
        successEl.style.animation = 'cp-fadein 0.5s ease both';
      } else {
        throw new Error('Server error');
      }
    } catch (err) {
      // Fallback: submit normally
      form.submit();
    } finally {
      submitBtn.classList.remove('cp-submit--loading');
      submitBtn.disabled = false;
    }
  });

  /* ── Scroll reveal ───────────────────────────────────────────────────────── */
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.cp-info-card, .cp-left__intro, .cp-socials').forEach(function (el) {
      el.style.opacity    = '0';
      el.style.transform  = 'translateY(18px)';
      el.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
      observer.observe(el);
    });
  }
}());
</script>
