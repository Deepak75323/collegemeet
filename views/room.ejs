<div class="studio-app">

<% if (locals.displayName) { %>
<script>
  sessionStorage.setItem("username", <%- JSON.stringify(displayName) %>);
</script>
<% } %>
<% if (locals.turnIce) { %>
<script>
  window.__ICE_TURN = <%- JSON.stringify(turnIce) %>;
</script>
<% } %>

  <!-- Partner video modal -->
  <div id="partner-video-modal" class="partner-modal" hidden>
    <div class="partner-modal__backdrop" id="partner-modal-backdrop"></div>
    <div class="partner-modal__panel">
      <div class="partner-modal__header">
        <span class="partner-modal__name" id="partner-modal-name">Partner</span>
        <div class="partner-modal__controls">
          <button class="partner-modal__btn" id="partner-modal-mute" title="Mute audio">
            <i class="fas fa-volume-up"></i><span>Mute</span>
          </button>
          <button class="partner-modal__btn" id="partner-modal-hide-video" title="Hide video">
            <i class="fas fa-video"></i><span>Hide video</span>
          </button>
          <button class="partner-modal__btn" id="partner-modal-fullscreen" title="Fullscreen">
            <i class="fas fa-expand"></i>
          </button>
          <button class="partner-modal__btn partner-modal__btn--close" id="partner-modal-close" title="Close">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
      <div class="partner-modal__video-wrap" id="partner-modal-video-wrap">
        <video id="partner-modal-video" autoplay playsinline class="partner-modal__video"></video>
        <div class="partner-modal__no-video" id="partner-modal-no-video" hidden>
          <i class="fas fa-video-slash" style="font-size:2rem;opacity:.4"></i>
          <p>Video hidden</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast container -->
  <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  <!-- Recording saved modal (used for both mid-call stop and leave-while-recording) -->
  <div id="recording-saved-modal" class="rec-modal-overlay" hidden>
    <div class="rec-modal">
      <div class="rec-modal__icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h3 class="rec-modal__title">Recording Saved</h3>
      <p class="rec-modal__body">Your recording is ready in this browser.<br><strong>Download</strong> saves a <code>.webm</code> file to your Downloads folder.<br><strong>Keep for Later</strong> stores it in this browser until you download or delete it.</p>
      <div class="rec-modal__actions">
        <button class="rec-modal__btn rec-modal__btn--primary" id="rec-download-btn">
          <i class="fas fa-download"></i>&nbsp; Download Recording
        </button>
        <button class="rec-modal__btn rec-modal__btn--secondary" id="rec-keep-btn">Keep for Later</button>
        <button class="rec-modal__btn rec-modal__btn--ghost-danger" id="rec-delete-btn">Delete Recording</button>
        <button class="rec-modal__btn rec-modal__btn--cancel" id="rec-cancel-btn">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Pre-join: create room -->
  <section class="studio-prejoin" id="room-create" hidden>
    <div class="studio-prejoin__brand">
      <div class="studio-prejoin__logo"><i class="fa fa-code-branch"></i></div>
      <h1 class="studio-prejoin__title">Start interview session</h1>
      <p class="studio-prejoin__subtitle">Collaborative editor, video, and chat for technical interviews.</p>
    </div>
    <div class="studio-card">
      <p class="studio-error" id="err-msg"></p>
      <div class="studio-field">
        <label for="room-name">Session name</label>
        <input type="text" id="room-name" class="studio-input" placeholder="e.g. Frontend loop">
      </div>
      <div class="studio-field">
        <label for="your-name">Your name</label>
        <input type="text" id="your-name" class="studio-input" placeholder="Your name" value="<%= typeof displayName !== 'undefined' ? displayName : '' %>">
      </div>
      <button type="button" id="create-room" class="studio-btn studio-btn--primary">Create session</button>
      <p class="studio-hint" id="room-created"></p>
    </div>
  </section>

  <!-- Pre-join: enter name -->
  <section class="studio-prejoin" id="username-set" hidden>
    <div class="studio-prejoin__brand">
      <div class="studio-prejoin__logo"><i class="fa fa-user-friends"></i></div>
      <h1 class="studio-prejoin__title">Join session</h1>
      <p class="studio-prejoin__subtitle">Enter your name to join the live room.</p>
    </div>
    <div class="studio-card">
      <p class="studio-error" id="err-msg-username"></p>
      <div class="studio-field">
        <label for="username">Your name</label>
        <input type="text" id="username" class="studio-input" placeholder="Your name" value="<%= typeof displayName !== 'undefined' ? displayName : '' %>">
      </div>
      <button type="button" id="enter-room" class="studio-btn studio-btn--primary">Join session</button>
    </div>
  </section>

  <!-- Live session -->
  <div class="studio-session room-comm" id="studio-session" hidden>
    <header class="studio-header call-toolbar room-comm" aria-label="Session controls">
      <div class="studio-header__meta">
        <h1 class="studio-header__title" id="studio-session-title">Peer coding session</h1>
        <div class="studio-header__sub">
          <span class="studio-pill studio-pill--live"><span class="studio-pill__dot"></span> Live</span>
          <span id="studio-connection-status">Connected</span>
          <span class="studio-pill studio-pill--debug" id="studio-debug-hint" hidden title="Open browser DevTools Console too">Debug on</span>
          <span id="studio-participant-count">1 participant</span>
          <span id="studio-session-timer">00:00</span>
        </div>
        <p class="studio-troubleshoot" id="studio-troubleshoot" role="status">Loading session…</p>
      </div>
      <div class="studio-header__controls">
        <button type="button" class="studio-icon-btn studio-icon-btn--labeled" id="toggle-video" title="Camera">
          <i class="fas fa-video"></i><span class="studio-icon-btn__label video-label">Video</span>
        </button>
        <button type="button" class="studio-icon-btn studio-icon-btn--labeled" id="toggle-mute" title="Microphone">
          <i class="fas fa-microphone"></i><span class="studio-icon-btn__label mic-label">Mute</span>
        </button>
        <button type="button" class="studio-icon-btn studio-icon-btn--labeled" id="share-screen" title="Share screen">
          <i class="fas fa-desktop"></i><span class="studio-icon-btn__label">Share</span>
        </button>
        <button type="button" class="studio-icon-btn studio-icon-btn--labeled studio-icon-btn--record" id="record" title="Record locally">
          <i class="fas fa-circle record-icon"></i><span class="studio-icon-btn__label record-label">Rec</span>
        </button>
        <div class="studio-icon-btn-wrap">
          <button type="button" class="studio-icon-btn studio-icon-btn--labeled" id="toggle-chat-pane" title="Chat">
            <i class="fas fa-comment"></i><span class="studio-icon-btn__label">Chat</span>
          </button>
          <span class="studio-badge" id="new-chat-notification" hidden>New</span>
        </div>
        <!-- Compact recording indicator (hidden until recording starts) -->
        <div id="rec-indicator" class="rec-indicator" hidden aria-label="Recording in progress">
          <span class="rec-indicator__dot"></span>
          <span class="rec-indicator__label">REC</span>
          <span class="rec-indicator__timer" id="rec-timer">00:00</span>
          <div class="rec-indicator__sep"></div>
          <button class="rec-indicator__stop" id="rec-stop-btn" title="Stop recording">Stop</button>
        </div>

        <button type="button" class="studio-icon-btn studio-icon-btn--leave" id="leave-call" title="Leave session">
          <i class="fas fa-phone-slash"></i> Leave
        </button>
      </div>
    </header>

    <div class="studio-body">
      <main class="studio-workspace" id="main-section">
        <div class="studio-workspace__inner">
          <aside class="studio-explorer" aria-label="Files">
            <div class="studio-explorer__head">
              Explorer
              <button class="studio-explorer__add" id="add-file-btn" title="New file">+</button>
            </div>
            <div id="studio-files-list"></div>
          </aside>

          <div class="studio-editor-col">
            <div class="studio-editor-bar">
              <div class="studio-editor-bar__tabs" id="editor-tabs">
                <!-- tabs injected by code-collab.js -->
              </div>
              <div class="studio-editor-bar__actions">
                <select id="code-language" class="studio-select" aria-label="Language">
                  <option value="javascript" selected>JavaScript</option>
                  <option value="python">Python</option>
                  <option value="html">HTML</option>
                  <option value="css">CSS</option>
                  <option value="java">Java</option>
                  <option value="cpp">C++</option>
                </select>
                <button type="button" class="studio-btn studio-btn--sm studio-btn--run" id="run-code-btn">
                  <i class="fa fa-play"></i> Run
                </button>
                <button type="button" class="studio-btn studio-btn--sm studio-btn--theme-toggle" id="toggle-editor-theme" title="Switch to light mode" aria-label="Toggle editor theme">
                  <i class="fas fa-sun"></i>
                </button>
                <span class="studio-sync-status" id="code-collab-status">Syncing…</span>
              </div>
            </div>

            <div id="peer-code-pane" class="studio-editor-pane">
              <textarea id="peer-code-editor" aria-label="Collaborative code editor"></textarea>
            </div>

            <div class="studio-terminal">
              <div class="studio-terminal__head">
                <span>Output <span id="terminal-runner-label" style="font-weight:400;opacity:.6"></span></span>
                <button type="button" class="studio-btn studio-btn--sm" id="clear-terminal-btn">Clear</button>
              </div>
              <pre class="studio-terminal__output" id="studio-terminal-output">Ready. Click Run to execute JavaScript.</pre>
            </div>
          </div>
        </div>
      </main>

      <aside class="studio-panel" id="collab-panel" aria-label="Collaboration">
        <div class="studio-panel__resizer" id="panel-resizer" title="Resize panel"></div>
        <nav class="studio-panel__tabs" role="tablist">
          <button type="button" class="studio-panel__tab studio-panel__tab--active" data-studio-tab="people" role="tab">People</button>
          <button type="button" class="studio-panel__tab" data-studio-tab="chat" role="tab">Chat</button>
          <button type="button" class="studio-panel__tab" data-studio-tab="activity" role="tab">Activity</button>
        </nav>

        <div class="studio-panel__body">
          <div class="studio-panel__pane studio-panel__pane--active" data-studio-pane="people" id="people-pane">
            <div class="studio-people-list" id="studio-people-list"></div>
            <p class="studio-people-empty" id="studio-video-hint">Partner video appears here when they join.</p>
            <div id="videos" class="studio-video-grid"></div>
          </div>

          <div class="studio-panel__pane" data-studio-pane="chat" id="chat-pane">
            <div id="chat-messages" class="studio-chat-feed"></div>
            <form class="studio-chat-compose" onsubmit="return false;">
              <textarea id="chat-input" class="studio-chat-input" rows="2" placeholder="Message the room…"></textarea>
              <button type="button" class="studio-chat-send" id="chat-input-btn" aria-label="Send">
                <i class="fa fa-paper-plane"></i>
              </button>
            </form>
          </div>

          <div class="studio-panel__pane" data-studio-pane="activity" id="activity-pane">
            <div class="studio-activity" id="studio-activity-feed"></div>
          </div>
        </div>
      </aside>
    </div>

    <div class="studio-pip" id="studio-pip" title="Picture-in-picture">
      <video class="mirror-mode" id="local" autoplay muted playsinline webkit-playsinline></video>
      <div class="studio-pip__overlay" id="studio-pip-overlay">
        <i class="studio-pip__overlay-icon fas fa-video-slash" id="studio-pip-icon"></i>
        <p class="studio-pip__overlay-msg" id="studio-pip-msg">Allow camera to see yourself</p>
        <button type="button" class="studio-pip__overlay-btn" id="enable-camera-btn">Enable camera</button>
      </div>
      <span class="studio-pip__label" id="studio-pip-label">You</span>
    </div>
  </div>

</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
