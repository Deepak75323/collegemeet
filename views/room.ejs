<script>
/* ── Editor theme toggle (dark / light) ─────────────────────────────────── */
(function () {
  var DARK  = 'dracula';
  var LIGHT = 'eclipse';
  var STORAGE_KEY = 'editor-theme';
  var current = localStorage.getItem( STORAGE_KEY ) || DARK;

  function applyTheme( theme ) {
    current = theme;
    localStorage.setItem( STORAGE_KEY, theme );

    var isLight = theme === LIGHT;
    var workspace = document.getElementById( 'studio-session' );
    if ( workspace ) workspace.setAttribute( 'data-editor-theme', isLight ? 'light' : 'dark' );

    /* Tell CodeMirror (if already initialised) to swap theme */
    if ( window.__setEditorTheme ) window.__setEditorTheme( theme );

    /* Update button icon + tooltip */
    var btn  = document.getElementById( 'toggle-editor-theme' );
    var icon = btn && btn.querySelector( 'i' );
    if ( btn )  btn.title = isLight ? 'Switch to dark mode' : 'Switch to light mode';
    if ( icon ) icon.className = isLight ? 'fas fa-moon' : 'fas fa-sun';
  }

  /* Apply on load so the theme is set before the editor renders */
  applyTheme( current );

  document.addEventListener( 'DOMContentLoaded', function () {
    applyTheme( current ); /* re-apply now that DOM is fully available */
    var btn = document.getElementById( 'toggle-editor-theme' );
    if ( btn ) {
      btn.addEventListener( 'click', function () {
        applyTheme( current === DARK ? LIGHT : DARK );
      } );
    }
  } );

  /* Public: called by code-collab.js when editor becomes ready */
  window.__applyEditorTheme = applyTheme;
  window.__getEditorTheme   = function () { return current; };
} )();
</script>
<script>
  setTimeout(function () {
    if (!window.__rtcLoaded) {
      var el = document.getElementById('studio-troubleshoot') || document.body;
      var msg = 'Room scripts did not load. Open DevTools → Console for errors (e.g. blocked module or 404 on /js/rtc.js).';
      if (el.id === 'studio-troubleshoot') el.textContent = msg;
      else el.insertAdjacentHTML('beforeend', '<p style="color:#f85149;padding:1rem">' + msg + '</p>');
    }
  }, 4000);
</script>
