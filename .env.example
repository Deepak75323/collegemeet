# =============================================================================
# OPTION A — Docker Compose (easiest: app + MongoDB + Redis on one server)
# Copy to .env and set SESSION_SECRET. Docker overrides MONGODB_URI / REDIS_*.
# =============================================================================

PORT=8000
NODE_ENV=production
SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32

DB=blog_website
MONGODB_URI=mongodb://mongo:27017/blog_website

# Redis — use ONE of these options:
#
# Option 1 — single URL (Upstash "Redis Connect" string):
#   REDIS_URL=rediss://default:PASSWORD@mint-oryx-91029.upstash.io:6379
#
# Option 2 — separate fields:
#   REDIS_HOST=mint-oryx-91029.upstash.io
#   REDIS_PORT=6379
#   REDIS_PASSWORD=your-password
#   REDIS_TLS=true
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=

SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://YOUR-DOMAIN.com/users/auth/google/callback

asset_path=/public

# WebRTC TURN (optional — required for some corporate networks / production video)
# Google STUN is always used. Add TURN when calls work locally but fail for remote users.
#
# Comma-separated URLs, or JSON array:
#   TURN_URLS=turn:global.turn.example.com:3478,turns:global.turn.example.com:5349?transport=tcp
#   TURN_URLS=["turn:your.turn.server:3478","turn:your.turn.server:3478?transport=tcp"]
#
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Server room flow logs → console + production_logs/room-flow.log (dev default on)
DEBUG_LOGS=1
# Extra JSON detail in stream logs
DEBUG_STREAM=1


# =============================================================================
# OPTION B — Managed MongoDB + Redis (use these instead when not using Docker DBs)
# =============================================================================
#
# MongoDB Atlas (https://cloud.mongodb.com):
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/blog_website?retryWrites=true&w=majority
#
# Upstash Redis (https://upstash.com) — free tier, works with Atlas deploy:
#   REDIS_HOST=xxxxx.upstash.io
#   REDIS_PORT=6379
#   REDIS_PASSWORD=your-upstash-token
#   REDIS_TLS=true
#
# Redis Cloud (https://redis.com/try-free/):
#   REDIS_HOST=redis-xxxxx.cxxx.region.redislabs.com
#   REDIS_PORT=6379
#   REDIS_PASSWORD=your-redis-password
